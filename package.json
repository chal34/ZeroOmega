{
  "name": "zeroomega",
  "version": "3.4.5",
  "private": true,
  "description": "ZeroOmega browser extension - proxy management",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:release": "BUILD=release pnpm -r run build",
    "test": "pnpm -r run test",
    "assemble": "node omega-build/assemble.mjs",
    "ext:build": "pnpm -r run build && node omega-build/assemble.mjs",
    "ext:release": "BUILD=release pnpm -r run build && node omega-build/assemble.mjs",
    "release": "pnpm --filter omega-target-chromium-extension run release",
    "clean": "pnpm -r run clean --if-present"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
